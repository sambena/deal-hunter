# Deal Hunter's settings. Copy to .env for local work; never commit .env or put a secret on a command line.

# Local work: the dev login stands in for Cougar Cave sign-in (127.0.0.1 and http only).
APP_ORIGIN=http://127.0.0.1:8780
PORT=8780
DEV_LOGIN=1

# Live: the address people use, and Cougar Cave sign-in (values from the owner console's Add app).
# APP_ORIGIN=https://deals.cougarcave.dev
# HOST=0.0.0.0
# DEV_LOGIN=0
# OIDC_ISSUER=https://<login service>/application/o/<app>/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# OWNERS=<the owner's central subject>
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# DATA_DIR=/data
# DATABASE_URL: from the .db.env file the owner console's Add app writes (never in this file).
# AI_SETTINGS_FILE=/run/cougar-ai/settings.json
